# Managed by chezmoi. Identity lives in ~/.gitconfig.local (created once).
[include]
    path = ~/.gitconfig.local

[core]
    autocrlf = input
    editor = nvim
    pager = delta

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[rerere]
    enabled = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    # "ansi" follows the terminal's color scheme (Tracer) — no hex duplication
    syntax-theme = ansi

{{ if ne .chezmoi.os "windows" -}}
[credential]
    helper = cache --timeout=3600

{{ end -}}
# gh holds the GitHub token; no hourly re-prompt, nothing written to disk.
# gh is on both package lists (nix: gh, winget: GitHub.cli), so this works
# on either OS. The empty helper first resets the list: credential.helper
# accumulates, and Git for Windows registers Git Credential Manager in its
# own system gitconfig, so without the reset GCM answers for GitHub before
# gh is ever asked. Every other host still falls through to whatever the
# system file registers.
[credential "https://github.com"]
    helper =
    helper = !gh auth git-credential

[credential "https://gist.github.com"]
    helper =
    helper = !gh auth git-credential

[ghq]
    root = ~/repos

{{ if eq .chezmoi.os "windows" -}}
[core]
    autocrlf = false
{{ end -}}
