# Managed by chezmoi. Identity lives in ~/.gitconfig.local (created once).
[include]
    path = ~/.gitconfig.local

[core]
    autocrlf = input
{{ if ne .chezmoi.os "windows" -}}
    # delta/nvim come from Nix; not installed on the minimal Windows layer
    editor = nvim
    pager = delta
{{ end -}}

[init]
    defaultBranch = main

[pull]
    rebase = true

[push]
    autoSetupRemote = true

[fetch]
    prune = true

[rerere]
    enabled = true

[merge]
    conflictstyle = zdiff3

[diff]
    colorMoved = default

{{ if ne .chezmoi.os "windows" -}}
[interactive]
    diffFilter = delta --color-only

[delta]
    navigate = true
    line-numbers = true
    # "ansi" follows the terminal's Tokyo Night palette — no hex duplication
    syntax-theme = ansi
{{ end -}}

{{ if ne .chezmoi.os "windows" -}}
[credential]
    helper = cache --timeout=3600

# gh holds the GitHub token; no hourly re-prompt, nothing written to disk
[credential "https://github.com"]
    helper = !gh auth git-credential
{{ else -}}
[credential]
    # Git for Windows bundles Git Credential Manager; cache needs a Unix
    # socket and gh is not on the minimal winget list
    helper = manager
{{ end -}}

[ghq]
    root = ~/repos

{{ if eq .chezmoi.os "windows" -}}
[core]
    autocrlf = false
{{ end -}}
