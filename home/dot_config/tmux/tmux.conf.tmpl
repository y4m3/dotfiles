# Minimal tmux: fallback multiplexer (herdr is primary). Default keybindings.

set -s escape-time 10
set -s default-terminal "tmux-256color"
set -ag terminal-overrides ",*:RGB"

# Clipboard via OSC52: the outer terminal writes the system clipboard,
# so copies stay UTF-8 (no clip.exe mojibake) and work over SSH too.
set -g set-clipboard on
# Let programs inside tmux (nvim) pass their own OSC52 through.
set -g allow-passthrough on

# Agents rewrite files behind nvim; focus-events drives autoread.
set -g focus-events on

set -g history-limit 50000
set -g mouse on
setw -g mode-keys vi
bind -T copy-mode-vi v send -X begin-selection
bind -T copy-mode-vi y send -X copy-selection-and-cancel
{{ if .is_wsl }}
# tmux strftime ignores TZ on WSL and renders UTC; use date(1) for both
# the time and the date (a UTC date is a day behind JST from 00:00-09:00).
set -g status-right '"#{=21:pane_title}" #(date +"%%H:%%M %%d-%%b-%%y")'
{{ end -}}
