# shellcheck shell=bash
# ~/.bashrc — single-pass init.
# Layout: env/PATH (non-interactive safe) -> interactive guard -> options ->
# fragments in ~/.bashrc.d/ -> ~/.bashrc.local overrides (always last).

# --- Environment -------------------------------------------------------------
export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
export XDG_CACHE_HOME="${XDG_CACHE_HOME:-$HOME/.cache}"
export XDG_STATE_HOME="${XDG_STATE_HOME:-$HOME/.local/state}"

# --- PATH (built once; first entry wins) -------------------------------------
__path_prepend() {
  case ":$PATH:" in
  *":$1:"*) ;;
  *) [ -d "$1" ] && PATH="$1:$PATH" ;;
  esac
  # Always succeed: this is exposed to ~/.bashrc.env.local, where a missing
  # directory must not make that file's last command fail.
  return 0
}
__path_prepend "/nix/var/nix/profiles/default/bin"
__path_prepend "$HOME/.nix-profile/bin"
__path_prepend "$HOME/.local/bin"
export PATH
# __path_prepend stays defined until after ~/.bashrc.env.local below, which
# needs it. A plain PATH="$dir:$PATH" doubles the entry every time a shell
# starts inside another one.

# Nix daemon environment (NIX_PATH, certs, etc.)
# shellcheck disable=SC1091
if [ -e /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh ]; then
  . /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh
fi

# Home Manager session variables (TZ etc. from home.nix sessionVariables)
# shellcheck disable=SC1091
if [ -e "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh" ]; then
  . "$HOME/.nix-profile/etc/profile.d/hm-session-vars.sh"
fi

# Env fragments: exports only, so non-interactive shells (agents, ssh
# commands) also get EDITOR, RIPGREP_CONFIG_PATH, BROWSER.
for __frag in "$HOME/.bashrc.d/010-env.sh" "$HOME/.bashrc.d/810-wsl.sh"; do
  # shellcheck disable=SC1090
  [ -r "$__frag" ] && . "$__frag"
done
unset __frag

# Machine-local environment, sourced before the interactive guard. Tool
# installers (rustup and friends) append PATH lines to ~/.bashrc and
# ~/.bash_profile, which this tree manages and reverts on the next apply.
# ~/.bashrc.local is the usual home for such edits, but it sits after the
# guard, so it never runs for `bash -lc` or the shell sshd starts for
# `ssh host cmd`. Put exports only here: this file runs in non-interactive
# shells too. `__path_prepend <dir>` is available to it and is the safe way
# to extend PATH there.
# shellcheck disable=SC1091
[ -r "$HOME/.bashrc.env.local" ] && . "$HOME/.bashrc.env.local"
unset -f __path_prepend

# --- Interactive-only below --------------------------------------------------
case $- in *i*) ;; *) return ;; esac

# History: large, deduped, shared across sessions. .bashrc.d/200-integrations.sh
# registers the write and read hooks idempotently.
HISTSIZE=50000
HISTFILESIZE=100000
HISTCONTROL=ignoreboth:erasedups
shopt -s histappend
shopt -s checkwinsize
shopt -s globstar

# --- Fragments (this loop skips the env fragments loaded above) -------------
if [ -d "$HOME/.bashrc.d" ]; then
  for __frag in "$HOME"/.bashrc.d/*.sh; do
    case "$__frag" in */010-env.sh | */810-wsl.sh) continue ;; esac
    # shellcheck disable=SC1090
    [ -r "$__frag" ] && . "$__frag"
  done
  unset __frag
fi

# --- Machine-local overrides (kept last so they win) -------------------------
# shellcheck disable=SC1091
[ -r "$HOME/.bashrc.local" ] && . "$HOME/.bashrc.local"
