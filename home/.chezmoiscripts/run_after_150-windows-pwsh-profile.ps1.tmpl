{{- if eq .chezmoi.os "windows" -}}
# Point the real $PROFILE at the chezmoi-managed profile body.
#
# PowerShell builds $PROFILE from the Personal known folder. OneDrive
# "Known Folder Move" redirects that folder into the OneDrive tree, but
# chezmoi always writes to the literal %USERPROFILE%\Documents. On a
# redirected machine those are two different directories, so a profile
# deployed under Documents never loads. Deploy the body to the XDG path
# (~/.config/powershell/profile.ps1, which nothing redirects) and write a
# loader to whatever $PROFILE actually resolves to.
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

# Get-Content -Raw returns $null for a zero-byte file and throws for a
# directory or a file it cannot read, and this script has to tell "empty"
# apart from "not there" and keep going either way.
function Read-TextOrNull($path) {
    try { return [IO.File]::ReadAllText($path) }
    catch { return $null }
}

# GetFolderPath('MyDocuments') honours the redirection and returns the same
# path under Windows PowerShell 5.1 (which runs this script) and pwsh 7.
$documents = [Environment]::GetFolderPath('MyDocuments')
if (-not $documents) {
    Write-Warning 'Could not resolve the Documents folder; skipping the pwsh profile loader'
    exit 0
}

$profilePath = Join-Path $documents 'PowerShell\Microsoft.PowerShell_profile.ps1'
$body = Join-Path $env:USERPROFILE '.config\powershell\profile.ps1'

# The marker identifies files this script owns, so it never overwrites a
# hand-written profile without keeping a copy first.
$marker = '# chezmoi:pwsh-profile-loader'
$loader = @"
$marker
# Generated by chezmoi (run_after_150-windows-pwsh-profile.ps1). Do not
# edit. The profile body lives at the path below; machine-local settings
# belong in ~/.config/powershell/profile.local.ps1.
#
# Literal ~/.config, not XDG_CONFIG_HOME: chezmoi deploys the body there
# whatever that variable says, so honouring it would point the loader at
# a file that does not exist.
`$__profileBody = Join-Path `$env:USERPROFILE '.config\powershell\profile.ps1'
if (Test-Path -LiteralPath `$__profileBody) { . `$__profileBody }
else {
    # This loader outlives the body it loads: it is written to the real
    # `$PROFILE, which chezmoi does not manage, so a branch that stops
    # deploying the body leaves this file behind pointing at nothing.
    # Without a word here the shell would come up with none of the profile
    # and no reason given.
    Write-Warning "Profile body not found: `$__profileBody -- run 'chezmoi apply', or restore a .pre-chezmoi*.bak from beside this file."
}
"@

# -LiteralPath throughout: [ and ] are legal in a Windows user name, and the
# default -Path would read them as a wildcard. A path built from $env:USERPROFILE
# would then match something other than the file meant, or nothing at all.
if (-not (Test-Path -LiteralPath $body)) {
    Write-Warning "Profile body not found: $body"
}

$current = Read-TextOrNull $profilePath

# $null covers both "not there" and "there but unreadable", and the two must
# not share a path. Windows grants read and write separately, so a profile
# this script cannot read may still be one it can overwrite -- and it cannot
# be copied either, so writing would drop the very file the backup below
# promises to keep. Leave it alone and say so.
if ($null -eq $current -and [IO.File]::Exists($profilePath)) {
    Write-Warning "Could not read the profile already at $profilePath, so it was left alone"
}
elseif ($current -eq $loader) {
    Write-Host "already current: $profilePath"
}
else {
    # Keep one copy of anything that is not ours. This script runs on every
    # apply, so a profile hand-written after an earlier run must not be
    # overwritten just because a backup from that run is already there.
    if ($null -ne $current -and $current -notmatch [regex]::Escape($marker)) {
        # Walk to the first backup slot that is either free or already holds
        # exactly this content. A timestamp would collide with itself when two
        # runs land in the same second, and this script runs on every apply.
        $backup = "$profilePath.pre-chezmoi.bak"
        $n = 0
        # Test-Path, not [IO.File]::Exists: a directory sitting on the slot name
        # must count as taken, or Copy-Item would drop the profile inside it.
        while ((Test-Path -LiteralPath $backup) -and ((Read-TextOrNull $backup) -ne $current)) {
            $n++
            $backup = "$profilePath.pre-chezmoi-$n.bak"
        }
        if (-not (Test-Path -LiteralPath $backup)) {
            Copy-Item -LiteralPath $profilePath -Destination $backup
            # Say where its contents have to go. The loader does not read
            # the backup, so an alias or function left in it is gone from
            # the next session, and a copy nobody knows to open is no
            # better than no copy.
            Write-Host "kept the previous profile: $backup"
            Write-Host "  it is not loaded any more -- move what you still want into ~/.config/powershell/profile.local.ps1"
        }
    }

    # CreateDirectory takes the path literally and does nothing when the
    # directory is already there, so neither wildcard rules nor a check first.
    $dir = Split-Path $profilePath -Parent
    $null = [IO.Directory]::CreateDirectory($dir)
    # UTF-8 without a BOM: pwsh reads it correctly and git keeps it clean.
    [IO.File]::WriteAllText($profilePath, $loader, [Text.UTF8Encoding]::new($false))
    Write-Host "wrote the loader: $profilePath"
}

# An earlier layout shipped the body straight to %USERPROFILE%\Documents.
# On a redirected machine that copy is dead weight that shadows nothing but
# confuses the next reader, so drop it. Only touch the literal path, and
# only when it is not the real $PROFILE. Match the body's opening comment
# rather than the marker: a machine that ran the earlier layout has a copy
# from before the marker existed.
#
# No Test-Path on the way in: under $ErrorActionPreference = 'Stop' it throws
# UnauthorizedAccessException on a path the script may not traverse, which
# would take the whole run down. Read-TextOrNull already answers "not there"
# and "cannot read" the same safe way.
$legacy = Join-Path $env:USERPROFILE 'Documents\PowerShell\Microsoft.PowerShell_profile.ps1'
if ($legacy -ne $profilePath) {
    $legacyText = Read-TextOrNull $legacy
    if ($legacyText -match '# PowerShell 7 profile\. Carries the prompt ported from') {
        Remove-Item -LiteralPath $legacy -Force
        Write-Host "removed the mis-targeted copy: $legacy"
    }
}

# The layout before this one also left files under the same (possibly
# redirected) Documents folder, and .chezmoiremove cannot reach them: its
# patterns resolve against the literal %USERPROFILE%, so on a redirected
# machine they never match. Remove them here, where the redirected path is
# already known. Match a distinctive line first, so a hand-written file of
# the same name survives.
$stale = @(
    @{
        Path   = Join-Path $documents 'WindowsPowerShell\Microsoft.PowerShell_profile.ps1'
        Match  = '# Windows PowerShell 5\.1 Profile Loader'
        Reason = 'this tree targets pwsh 7 only, and chezmoi runs its own scripts through 5.1'
    },
    @{
        Path         = Join-Path $documents 'PowerShell\profile.ps1'
        Match        = '(?m)^#\s*Intentionally left empty'
        # "Intentionally left empty" is a phrase anyone might write in a
        # profile of their own. Only treat the file as the stub this tree
        # used to ship when it carries no code at all.
        CommentsOnly = $true
        Reason       = 'the AllHosts profile pointed at the profile.d directory this tree removed'
    }
)

foreach ($item in $stale) {
    # Same reason as $legacy above: no Test-Path, the read answers both.
    $text = Read-TextOrNull $item.Path
    if ($null -eq $text) { continue }
    if ($text -notmatch $item.Match) { continue }
    if ($item.ContainsKey('CommentsOnly') -and
        ($text -split "`r?`n" | Where-Object { $_.Trim() -and $_.TrimStart() -notlike '#*' })) {
        continue
    }
    Remove-Item -LiteralPath $item.Path -Force
    Write-Host "removed a file from the earlier layout ($($item.Reason)): $($item.Path)"
}
{{ end -}}
