{{- if eq .chezmoi.os "windows" -}}
# nvim (and other XDG-aware tools) on Windows read the XDG base dirs.
# nvim splits config/data/state/cache across these four. This makes that
# manual setting reproducible. Check before package installation on every
# apply, including retries; never overwrite an existing conflicting value.
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$xdgVars = @{
    XDG_CONFIG_HOME = '.config'
    XDG_DATA_HOME   = '.local\share'
    XDG_STATE_HOME  = '.local\state'
    XDG_CACHE_HOME  = '.cache'
}

$conflicts = @()
foreach ($name in $xdgVars.Keys) {
    $target = Join-Path $env:USERPROFILE $xdgVars[$name]
    $current = [Environment]::GetEnvironmentVariable($name, 'User')
    if ($current -and $current.TrimEnd('\') -ine $target.TrimEnd('\')) {
        $conflicts += "$name=$current (expected $target)"
    }
}
if ($conflicts.Count) {
    throw ('XDG settings conflict with the deployed paths; review manually: ' + ($conflicts -join '; '))
}

foreach ($name in $xdgVars.Keys) {
    $target = Join-Path $env:USERPROFILE $xdgVars[$name]
    $current = [Environment]::GetEnvironmentVariable($name, 'User')

    if ($current) {
        Write-Host "already set: $name=$target"
    }
    else {
        [Environment]::SetEnvironmentVariable($name, $target, 'User')
        Write-Host "set: $name=$target"
    }
}
{{ end -}}
