{{- if eq .chezmoi.os "linux" -}}
#!/bin/bash
# Tighten permissions on credential files. Runs on apply when this script
# changes — replaces the old 250-line .bashrc fragment that ran every shell.
# Must be an after_ script: non-after scripts run before chezmoi writes
# managed files, so ~/.gitconfig.local would not exist yet on a fresh
# machine and the chmod would be skipped forever (run_onchange never
# retries unless this file changes).
set -euo pipefail

secure_dir() { [ -d "$1" ] && chmod 700 "$1" || true; }
secure_file() { [ -f "$1" ] && chmod 600 "$1" || true; }

secure_dir "$HOME/.ssh"
secure_dir "$HOME/.gnupg"

if [ -d "$HOME/.ssh" ]; then
  find "$HOME/.ssh" -type f ! -name "*.pub" -exec chmod 600 {} +
  find "$HOME/.ssh" -type f -name "*.pub" -exec chmod 644 {} +
fi

secure_file "$HOME/.gitconfig.local"
secure_file "$HOME/.netrc"
{{ end -}}
