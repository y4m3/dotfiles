{{- if eq .chezmoi.os "windows" -}}
# Install Windows infrastructure via winget before deploying configuration.
# Re-runs when the list in
# .chezmoidata/packages.yaml changes.
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

$apps = @(
{{- range .packages.winget }}
    "{{ . }}"
{{- end }}
)

if (-not (Get-Command winget -ErrorAction SilentlyContinue)) {
    Write-Warning "winget not found; install 'App Installer' from the Microsoft Store first"
    exit 1
}

# No 2>$null on winget: under $ErrorActionPreference='Stop' on Windows
# PowerShell 5.1 a redirected stderr line becomes a terminating error.
$failed = @()
foreach ($id in $apps) {
    # --accept-source-agreements on the probe too: the first-ever winget
    # run otherwise blocks on an interactive prompt hidden by the pipe
    $listing = @(winget list --id $id --exact --source winget --accept-source-agreements)
    $probeExit = $LASTEXITCODE
    # APPINSTALLER_CLI_ERROR_NO_APPLICATIONS_FOUND is an absent package,
    # not a source/network failure. Do not treat other errors as absence.
    if ($probeExit -ne 0 -and $probeExit -ne -1978335212) {
        Write-Warning "lookup failed: $id (exit code $probeExit)"
        $failed += $id
        continue
    }
    $found = $probeExit -eq 0
    if ($found) {
        Write-Host "ok: $id"
    }
    else {
        Write-Host "installing: $id"
        winget install --id $id --exact --source winget --silent `
            --accept-package-agreements --accept-source-agreements
        if ($LASTEXITCODE -ne 0) {
            Write-Warning "install failed: $id (exit code $LASTEXITCODE)"
            $failed += $id
        }
    }
}

if ($failed.Count -gt 0) {
    # Exit nonzero so chezmoi does not record this run and retries next apply
    Write-Warning ("not installed: " + ($failed -join ', '))
    exit 1
}
{{ end -}}
