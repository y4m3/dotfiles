{{- if eq .chezmoi.os "windows" -}}
# Install uv-supplied nvim tools (Python LSP/formatters) declared in
# .chezmoidata/packages.yaml. Re-runs when that list changes.
$ErrorActionPreference = 'Stop'
Set-StrictMode -Version Latest

{{ template "windows-mise.ps1" . }}
# Resolve uv from this global toolset rather than an older winget copy.
$uvPath = & $miseExe --no-config which uv --tool 'aqua:astral-sh/uv@{{ index .packages.mise "aqua:astral-sh/uv" }}'
if ($LASTEXITCODE -ne 0 -or -not $uvPath) { throw 'mise-managed uv is not installed' }
$uvPath = ([string]$uvPath).Trim()
# Keep entry points stable and Python environments independent of mise's
# runtime cleanup. uv owns the Python interpreter used by these CLI tools.
$env:UV_TOOL_BIN_DIR = Join-Path $env:USERPROFILE '.local\bin'

# Register PATH only after all requested tools installed successfully.
$failed = @()
{{ range .packages.uv }}
Write-Host "installing: {{ . }}"
& $uvPath tool install --managed-python {{ . }}
if ($LASTEXITCODE -ne 0) { $failed += '{{ . }}' }
{{ end -}}
if ($failed.Count -gt 0) { throw ('uv tool install failed: ' + ($failed -join ', ')) }

# uv tool puts entry points in %USERPROFILE%\.local\bin. Append it to the
# user PATH if missing. Read and write the raw registry value (unexpanded),
# same non-destructive style as run_before_100-windows-xdg-env: never remove
# existing entries. Compare entries expanded, case-insensitively, and
# trailing-backslash-insensitively: an existing entry may already be a
# literal "C:\Users\...\.local\bin" instead of the %USERPROFILE% form, and
# that must still count as present so we do not append a duplicate.
$shimDir = '%USERPROFILE%\.local\bin'
$shimDirExpanded = [Environment]::ExpandEnvironmentVariables($shimDir).ToLowerInvariant().TrimEnd('\')
$envKey = [Microsoft.Win32.Registry]::CurrentUser.OpenSubKey('Environment', $true)
try {
    $userPath = [string]$envKey.GetValue('Path', '', [Microsoft.Win32.RegistryValueOptions]::DoNotExpandEnvironmentNames)
    $entries = $userPath -split ';' | Where-Object { $_ }
    $alreadyPresent = $entries | Where-Object {
        ([Environment]::ExpandEnvironmentVariables($_).ToLowerInvariant().TrimEnd('\')) -eq $shimDirExpanded
    }
    if (-not $alreadyPresent) {
        $newPath = if ($userPath) { "$userPath;$shimDir" } else { $shimDir }
        $envKey.SetValue('Path', $newPath, [Microsoft.Win32.RegistryValueKind]::ExpandString)
        Write-Host "added to PATH: $shimDir"
    }
}
finally {
    $envKey.Close()
}

{{ end -}}
