# Default: LF for all text files
* text=auto eol=lf

# Explicit text declarations for everything this tree contains - LF
*.sh text eol=lf
*.sh.tmpl text eol=lf
install.sh text eol=lf
*.lua text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.nix text eol=lf
*.md text eol=lf
*.tmpl text eol=lf

# PowerShell - CRLF (after *.tmpl so the override wins)
*.ps1 text eol=crlf
*.ps1.tmpl text eol=crlf
